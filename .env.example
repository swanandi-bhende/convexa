# -- LLM (Groq - Free) -----------------------------
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# -- Blockchain RPC (Alchemy - Free) ---------------
ALCHEMY_RPC_URL=https://unichain-sepolia.g.alchemy.com/v2/your_key
ALCHEMY_WS_URL=wss://unichain-sepolia.g.alchemy.com/v2/your_key

# -- Wallets ----------------------------------------
DEPLOYER_PRIVATE_KEY=your_deployer_private_key
AGENT_WALLET_PRIVATE_KEY=your_agent_wallet_key
AGENT_WALLET_ADDRESS=your_agent_wallet_address

# -- KeeperHub --------------------------------------
KEEPERHUB_API_KEY=your_keeperhub_api_key
KEEPERHUB_EXECUTOR_ADDRESS=keeperhub_executor_wallet_address
KEEPERHUB_MCP_URL=https://mcp.keeperhub.com

# -- Uniswap ----------------------------------------
UNISWAP_API_KEY=your_uniswap_api_key
UNISWAP_API_BASE=https://api.uniswap.org/v1
MARKET_DATA_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/your_key
THEGRAPH_UNISWAP_V3_ENDPOINT=https://api.thegraph.com/subgraphs/name/uniswap/uniswap-v3
UNISWAP_V3_FACTORY_ADDRESS=your_uniswap_v3_factory_address
WETH_ADDRESS=your_weth_address_on_network
USDC_ADDRESS=your_usdc_address_on_network
UNISWAP_V3_POOL_FEES=500,3000,10000
UNISWAP_V3_POOL_ETH_USDC=your_uniswap_v3_pool_address
TOKEN_DECIMALS_ETH_USDC=18,6
LARGE_SWAP_USD_THRESHOLD=50000

# -- Gensyn AXL Nodes -------------------------------
BULL_AXL_PORT=8001
BEAR_AXL_PORT=8002
JUDGE_AXL_PORT=8003
AXL_BINARY_PATH=./axl-nodes/axl
JUDGE_AXL_PEER_ID=your_judge_axl_peer_id
BEAR_AXL_HTTP_URL=http://localhost:8001

# -- Deployed Contracts (fill after Step 2 & 3) -----
ESCROW_CONTRACT_ADDRESS=
CONVICTION_CONTRACT_ADDRESS=

# -- Debate Config -----------------------------------
ROUND_INTERVAL_SECONDS=60
CONVICTION_WIN_THRESHOLD=70
MIN_STAKE_ETH=0.001
MAX_DEBATE_ROUNDS=20
MICRO_SETTLEMENT_PERCENT=2

# -- Database & Logging ------------------------------
DATABASE_URL=sqlite:///./utils/db/debate.db
LOG_LEVEL=INFO
